# Copie para .env e troque as senhas:   cp .env.example .env

# ---- Banco de dados ----
DB_ROOT_PASSWORD=troque_root_123
DB_NAME=confeitaria
DB_USER=confeitaria
DB_PASSWORD=troque_app_123

# ---- Portas no host ----
# 3306, 5173, 8000 e 8080 já estão em uso por outro projeto.
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081
API_PORT=3001
WEB_PORT=5174

# ---- API ----
# Origens web liberadas no CORS (separadas por vírgula).
# O app de celular (Kotlin/Dart) não precisa de CORS.
CORS_ORIGINS=http://localhost:5174

# ---- Frontend ----
VITE_USE_POLLING=true
